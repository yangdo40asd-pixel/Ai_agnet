# 실제 값은 .env에만 넣는다. 이 파일은 설정 항목의 예시다.
# 기존 .env를 덮어쓰지 말고 필요한 항목을 추가한다.

# groq(기존 기본값) 또는 local. 로컬 실패 시 Groq로 자동 전환하지 않는다.
AI_PROVIDER="groq"
# Groq를 선택할 때 사용하는 기존 설정.
GROQ_API_KEY=""
# 2026-10-15 실제 연동 비교 후 설정. 향후 모델 제공 여부는 달라질 수 있다.
GROQ_MODEL="openai/gpt-oss-20b"

# 로컬 모드: 모델 서버는 별도로 실행한다. 앱은 모델을 자동 로드하지 않는다.
# GPU 4K 짧은 요청 검수 주소. 긴 후속 질문은 8K 이상의 별도 검수가 필요하다.
LOCAL_LLM_BASE_URL="http://127.0.0.1:1234/v1"
LOCAL_LLM_MODEL="gemma-4-12b-q4"
LOCAL_LLM_CONNECT_TIMEOUT="5"
LOCAL_LLM_READ_TIMEOUT="180"
# schema 권장. json은 명시적으로 선택할 때만 사용하며 자동 재시도하지 않는다.
LOCAL_LLM_OUTPUT_MODE="schema"
LOCAL_LLM_API_KEY=""

# auto: 로컬은 신규 관계 판정 적용, Groq는 기존 경로 유지.
# strict: 공급자와 무관하게 신규 정책 적용. standard: 기존 경로를 명시적으로 사용.
# 실제 .env는 자동 변경하지 않는다. 정책 구현은 공급자와 독립적인 공통 계층이다.
NEWS_RELEVANCE_MODE="auto"

# 현재 뉴스 호출은 NAVER API HUB 방식이다.
# NAVER Developers용 키와 API HUB용 키는 서로 다를 수 있다.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# date = 발행일순, sim = 관련도순
NEWS_SORT="date"

# 뉴스 요청과 AI 요청의 제한 시간(초). KRX/yfinance 내부 요청까지 적용되지는 않는다.
REQUEST_TIMEOUT="30"

# OpenDART 재무 조회 키. AI 공급자와 무관하게 실제 금융 수집에 필요하다.
DART_API_KEY=""
# 아래 서비스는 현재 src 실행 코드에서는 사용하지 않는다.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LOCAL_LLM_CONTEXT="4096"
