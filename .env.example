# [주의] 이 파일은 예시(.example) 파일입니다. 
# 실제 사용할 때는 파일명을 '.env'로 변경하고 본인의 키를 입력하세요.
# '.env' 파일은 .gitignore에 의해 안전하게 보호됩니다.

# OpenAI API Key (필수)
OPENAI_API_KEY="sk-..."

# Groq API Key (선택/권장: 빠른 추론 속도용)
GROQ_API_KEY="gsk_..."

# 네이버 검색 API Key (뉴스 크롤링 차단 방지용 - 선택)
NAVER_CLIENT_ID="..."
NAVER_CLIENT_SECRET="..."

# Gemini API Key (���� ���̴� AI �γ� ���� - ����)
GEMINI_API_KEY="AIza..."
